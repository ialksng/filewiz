{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    },
    {
      "source": "/work/projects/filewiz/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/work/projects/filewiz/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/work/projects/filewiz/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/work/projects/filewiz/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ],
  "rewrites": [
    { "source": "/work/projects/filewiz/api/:path*", "destination": "/api/:path*" },
    { "source": "/work/projects/filewiz/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/work/projects/filewiz/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/work/projects/filewiz/robots.txt", "destination": "/robots.txt" },
    { "source": "/work/projects/filewiz/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/work/projects/filewiz/sw.js", "destination": "/sw.js" },
    { "source": "/work/projects/filewiz/demo.mp4", "destination": "/demo.mp4" },
    { "source": "/work/projects/filewiz/loader.mp4", "destination": "/loader.mp4" },
    { "source": "/work/projects/filewiz/logoWRB.png", "destination": "/logoWRB.png" },
    { "source": "/work/projects/filewiz/preview1.png", "destination": "/preview1.png" },
    { "source": "/work/projects/filewiz/pwa-192.png", "destination": "/pwa-192.png" },
    { "source": "/work/projects/filewiz/pwa-512.png", "destination": "/pwa-512.png" },
    { "source": "/work/projects/filewiz/", "destination": "/index.html" },
    { "source": "/work/projects/filewiz", "destination": "/index.html" },
    { "source": "/work/projects/filewiz/:path*", "destination": "/index.html" }
  ]
}
