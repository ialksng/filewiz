# Express API and MongoDB
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/filewiz
JWT_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=https://ialksng.me/work/projects/filewiz
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ialksng.me
FILEWIZ_ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional password reset email delivery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=FileWiz <no-reply@example.com>

# Gemini assistant and summaries
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional premium billing
#
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# FILEWIZ_PREMIUM_PRICE_PAISE=900
